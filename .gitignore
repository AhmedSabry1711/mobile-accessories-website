# Dependencies
node_modules/

# Build output (generated by `npm run build` or `deploy.ps1`)
dist/
.deploy/
mobiboost-deploy.zip
mobiboost-frontend.zip

# Runtime credentials — NEVER commit these.
# Local development keeps api/config.php; production keeps the real file OUTSIDE
# the web root at <account-home>/mobi-private/config.php (see
# HOSTINGER-GIT-DEPLOY.md). api/config.example.php is the committable template.
api/config.php
api/config.private.php
mobi-private/

# Runtime user media (ads / product uploads).
# The folder itself is tracked through .gitkeep so a deploy recreates it, but its
# contents are ignored: files uploaded by the shop owner must survive redeploys.
# Local seed art under uploads/seed/ is regenerated by: php api/seed.php
uploads/*
!uploads/.gitkeep

# Logs & OS junk
*.log
.DS_Store
Thumbs.db

# Secrets / local environment
.env
.env.local
